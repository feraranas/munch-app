# Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# Development
API_PORT=8080
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8080

# Authentication
# Generate a strong random secret, e.g. `openssl rand -hex 32`. Never commit a real value.
JWT_SECRET=replace-with-a-strong-random-secret
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Openpay Configuration
# Obtain these from your Openpay dashboard. Keep real values only in your local .env
# (gitignored) or your secret manager — never commit them.
OPENPAY_MERCHANT_ID=your-openpay-merchant-id
OPENPAY_PRIVATE_KEY=sk_your_openpay_private_key
OPENPAY_SANDBOX_MODE=true

# Production (override these in production deployment)
# API_PORT=8080
# FRONTEND_URL=https://yourdomain.com
# API_URL=https://api.yourdomain.com
# JWT_SECRET=your-secure-random-secret-here
# OPENPAY_MERCHANT_ID=your-production-merchant-id
# OPENPAY_PRIVATE_KEY=your-production-private-key
# OPENPAY_SANDBOX_MODE=false
