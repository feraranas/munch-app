# Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# Development
API_PORT=8080
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8080

# Authentication
# Generate a strong random secret, e.g. `openssl rand -hex 32`. Never commit a real value.
JWT_SECRET=replace-with-a-strong-random-secret
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# Stripe Configuration (Mexico)
# Restricted keys preferred in Dashboard. Keep real values only in local .env
# (gitignored) or your secret manager — never commit them.
# Leave unset for local mock payments (no live charges).
STRIPE_SECRET_KEY=rk_test_your_restricted_or_sk_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional on backend (frontend uses REACT_APP_STRIPE_PUBLISHABLE_KEY)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Production (override these in production deployment)
# API_PORT=8080
# FRONTEND_URL=https://yourdomain.com
# API_URL=https://api.yourdomain.com
# JWT_SECRET=your-secure-random-secret-here
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
