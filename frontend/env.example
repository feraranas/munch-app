# Frontend Environment Configuration
# Copy this file to .env and update the values for your environment

# Development
REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080
REACT_APP_FRONTEND_URL=http://localhost:3000

# Production (override these in production deployment)
# REACT_APP_API_URL=https://api.yourdomain.com
# REACT_APP_WS_URL=wss://api.yourdomain.com
# REACT_APP_FRONTEND_URL=https://yourdomain.com

# Openpay Configuration
# These are test credentials - replace with your production credentials in production
REACT_APP_OPENPAY_MERCHANT_ID=your-openpay-merchant-id
REACT_APP_OPENPAY_PUBLIC_API_KEY=pk_your_openpay_public_key
REACT_APP_OPENPAY_SANDBOX_MODE=true
