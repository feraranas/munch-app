    {
      "id": "admin-view-sessions",
      "title": "Admin views active table sessions",
      "subtitle": "Open /admin dashboard, list active QR sessions, drill into a table's POS",
      "meta": {
        "created": "2026-07-17",
        "updated": "2026-07-17"
      },
      "source_paths": [
        "frontend/src/components/AdminDashboard.tsx",
        "frontend/src/components/SessionGrid.tsx",
        "frontend/src/hooks/useQueries.ts",
        "frontend/src/services/api.ts",
        "backend/handlers.go"
      ],
      "actors": [
        {
          "id": "staff",
          "label": "Admin",
          "zone": "user",
          "sub_caption": "waitstaff"
        },
        {
          "id": "app",
          "label": "React App",
          "kind": "internal",
          "zone": "client",
          "sub": [
            {
              "id": "dash",
              "label": "AdminDashboard"
            },
            {
              "id": "grid",
              "label": "SessionGrid"
            },
            {
              "id": "query",
              "label": "useAdminSessions"
            }
          ]
        },
        {
          "id": "srv",
          "label": "Go Backend",
          "zone": "server",
          "sub_caption": "Gin handlers"
        },
        {
          "id": "db",
          "label": "Database",
          "zone": "datastore",
          "sub_caption": "GORM"
        }
      ],
      "messages": [
        {
          "phase": "LOAD"
        },
        {
          "from": "staff",
          "to": "app.dash",
          "text": "open /admin",
          "paths": [
            "list"
          ]
        },
        {
          "from": "app.dash",
          "to": "app.query",
          "text": "useAdminSessions()",
          "caption": "TanStack Query hook",
          "detail": {
            "why": "Subscribe the dashboard to the cached sessions list.",
            "effects": "Renders loading card until first fetch resolves."
          }
        },
        {
          "phase": "FETCH"
        },
        {
          "from": "app.query",
          "to": "srv",
          "text": "GET /admin/sessions",
          "via": "api",
          "paths": [
            "list"
